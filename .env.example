# Copier ce fichier en .env (non versionné) et adapter les valeurs.
# docker compose lit .env automatiquement ; pour le backend, exportez ces variables
# ou laissez les valeurs par défaut de application.yml, identiques à celles-ci.

DB_NAME=meal_planner
DB_USER=meal_planner
DB_PASSWORD=meal_planner
DB_PORT=5432

KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Backend
DB_URL=jdbc:postgresql://localhost:5432/meal_planner
OAUTH2_ISSUER_URI=http://localhost:8180/realms/meal-planner
# Chemin vers le fichier Ciqual à importer automatiquement au premier démarrage (optionnel)
CIQUAL_IMPORT_PATH=
