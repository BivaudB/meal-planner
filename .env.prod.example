# Production (docker-compose.prod.yml). Copier en .env.prod (non versionné) et remplacer
# chaque valeur "a-changer". Générer des mots de passe : openssl rand -base64 24
# Les mots de passe sont lus au premier démarrage (création de la base, import du realm) :
# les modifier ensuite ici ne change pas les comptes existants.

# --- Domaine -------------------------------------------------------------
# Nom de domaine pointant vers l'IP publique de la VM (ex. sous-domaine DuckDNS gratuit)
SITE_ADDRESS=mon-repas.duckdns.org
# URL publique, sans "/" final : https://<SITE_ADDRESS>
APP_URL=https://mon-repas.duckdns.org
# Adresse de contact pour Let's Encrypt (expiration de certificat)
ACME_EMAIL=vous@example.com

# --- PostgreSQL ----------------------------------------------------------
DB_NAME=meal_planner
DB_USER=meal_planner
DB_PASSWORD=a-changer
KEYCLOAK_DB_PASSWORD=a-changer

# --- Keycloak ------------------------------------------------------------
# Administrateur de Keycloak (console /auth/admin, par tunnel SSH)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=a-changer
# Comptes de l'application créés à l'import du realm : "demo" (rôle user) et "admin" (rôles user + admin)
KC_DEMO_PASSWORD=a-changer
KC_APP_ADMIN_PASSWORD=a-changer

# --- Divers --------------------------------------------------------------
# Recettes de base ajoutées au premier démarrage
RECIPE_CATALOG_ENABLED=true
# Ports locaux (127.0.0.1 de la VM) pour les tunnels SSH d'administration
# DB_ADMIN_PORT=5432
# KEYCLOAK_ADMIN_PORT=8180
